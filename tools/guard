#!/usr/bin/env python3
"""Generator CLI guard.

The plugin can block itself, but it cannot stop someone calling the generator CLI
directly. So the real CLI hides behind this wrapper: every credit-spending verb must
carry a single-use token, and a token can only be issued by the plugin's `run` after
a human approved the plan.

    export GENERATOR_CLI=$PWD/tools/guard          # point the plugin at the guard
    export GENERATOR_CLI_REAL=/path/to/your/cli    # the real generator lives here

    $GENERATOR_CLI video --image f.png --prompt "..." --duration 4 --ratio 3:4

No token -> refused, exit code 9, nothing is spent.

Spending verbs default to `video` and `image`; override with
    export GUARD_SPEND_VERBS=video,image,render
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
ROOT = HERE.parent
sys.path.insert(0, str(ROOT / "core"))
import gate  # noqa: E402

REAL_ENV = "GENERATOR_CLI_REAL"
TOKEN_ENV = "PLUGIN_TOKEN"
DEFAULT_SPEND = {"video", "image"}


def spend_verbs() -> set:
    raw = os.environ.get("GUARD_SPEND_VERBS", "")
    if raw.strip():
        return {v.strip() for v in raw.split(",") if v.strip()}
    return DEFAULT_SPEND


def real_cli() -> str:
    cli = os.environ.get(REAL_ENV)
    if not cli:
        print(json.dumps({
            "ok": False,
            "error": f"{REAL_ENV} is not set",
            "how": f"export {REAL_ENV}=/path/to/your/generator/cli",
        }, ensure_ascii=False), file=sys.stderr)
        raise SystemExit(9)
    return cli


def main() -> int:
    argv = sys.argv[1:]
    if not argv:
        return subprocess.call([real_cli()])

    verb = argv[0]
    if verb not in spend_verbs():
        os.execv(real_cli(), [real_cli(), *argv])
        return 0

    tok = os.environ.get(TOKEN_ENV, "")
    row = gate.consume_token(tok) if tok else None
    if not row:
        reason = "no token" if not tok else "token invalid, already used, or expired"
        gate.audit("exec_refuse", reason=reason, verb=verb,
                   model=_arg(argv, "--model"), args=" ".join(argv)[:300])
        print(json.dumps({
            "ok": False,
            "error": "blocked: the plugin must come first",
            "reason": reason,
            "verb": verb,
            "how": "plan -> human approve -> run; run issues the token itself",
        }, ensure_ascii=False, indent=2), file=sys.stderr)
        return 9

    gate.audit("exec_authorized", verb=verb, token=row.get("token"),
               plan=row.get("plan"), shot=row.get("shot"), model=_arg(argv, "--model"))
    env = dict(os.environ)
    env.pop(TOKEN_ENV, None)          # never hand the token downstream
    rc = subprocess.call([real_cli(), *argv], env=env)
    gate.log_result("generator", rc == 0, verb=verb, rc=rc)
    return rc


def _arg(argv: list, name: str) -> str:
    if name in argv:
        i = argv.index(name)
        if i + 1 < len(argv):
            return argv[i + 1]
    return ""


if __name__ == "__main__":
    sys.exit(main())
